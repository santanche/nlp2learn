{"metadata":{"produced_by":"01-corpus/01_generate_corpus.ipynb","function":"pick_showcase","source":"def pick_showcase(transcripts):\n    by_genome = {}\n    for tid, gid, c, t in transcripts:\n        by_genome.setdefault(gid, {})[c] = (tid, t)\n\n    def first(rule):\n        return next((tid, gid, c, t) for tid, gid, c, t in transcripts if rule(gid, c, t))\n\n    clean = lambda t: not has_broken_rbs(t) and not decoys(t)\n    pair_gid = next(gid for gid, d in by_genome.items()\n                    if len(d) == 2 and all(clean(t) for _, t in d.values()))\n    rules = [\n        (\"K_low\", \"Read-through transcript: all seven genes, true starts only\", lambda g, c, t: g == pair_gid and c == \"K_low\"),\n        (\"K_high\", \"The same genome attenuated: the leader is the last word\", lambda g, c, t: g == pair_gid and c == \"K_high\"),\n        (\"broken_rbs\", \"Read-through with one broken RBS: a WXZ that is not a start\",\n         lambda g, c, t: c == \"K_low\" and sum(r[\"start_role\"] == \"false_start_broken_rbs\" for r in t) == 1 and not decoys(t)),\n        (\"broken_rbs_K_high\", \"Attenuated transcript with a broken RBS in NaxGATE or NaxTAG\",\n         lambda g, c, t: c == \"K_high\" and has_broken_rbs(t)),\n        (\"decoy_with_marker\", \"Spacer decoy: WXZ followed by a gene marker, with no RBS in front\",\n         lambda g, c, t: c == \"K_low\" and any(m for _, m in decoys(t)) and not has_broken_rbs(t)),\n        (\"decoy_bare\", \"Spacer decoy: a bare WXZ in a spacer\",\n         lambda g, c, t: c == \"K_low\" and decoys(t) and not any(m for _, m in decoys(t)) and not has_broken_rbs(t)),\n    ]\n    showcase = []\n    for label, description, rule in rules:\n        tid, gid, c, t = first(rule)\n        showcase.append({\"label\": label, \"description\": description, \"transcript_id\": tid,\n                         \"genome_id\": gid, \"condition\": c, **columns(t, LABELS + [\"leader_state\"])})\n    return showcase\n\n\ndef transcribe_genome(genome, condition):\n    tss = max(r[\"position\"] for r in genome if r[\"region\"] == \"promoter\") + 1\n    stop_region = \"tx_terminator\" if condition == \"K_low\" else \"attenuator\"\n    end = max(r[\"position\"] for r in genome if r[\"region\"] == stop_region)\n    state = \"read_through\" if condition == \"K_low\" else \"attenuated\"\n\n    transcript = []\n    for i, r in enumerate(genome[tss:end + 1]):\n        t = dict(r, codon=L.transcribe(r[\"codon\"]), position=i)\n        t[\"leader_state\"] = state if r[\"region\"] in (\"ksensor\", \"attenuator\") else None\n        transcript.append(t)\n    return transcript\n","seed":42,"params":{"n_genomes":400,"transcripts_per_genome":4,"p_spacer_decoy":1.0,"p_broken_rbs":0.15,"p_decoy_marker":0.5,"flank_length":[10,40],"utr5_length":[0,2],"gap_length":[1,3],"body_length":[12,24],"intergenic_length":[0,2],"leader_spacer_length":[0,2],"operon_order":["pathway","shuffled"]},"generator_version":"1.0.0","created":"2026-11-02T01:24:18+00:00"},"fields":["codon","region","gene","start_role","residue","pos_in_gene","leader_state"],"transcripts":[{"label":"K_low","description":"Read-through transcript: all seven genes, true starts only","transcript_id":5,"genome_id":1,"condition":"K_low","codon":["YYW","WXX","WXX","VXY","WXV","WWX","XXY","XYX","XWX","YVX","XXX","YVX","YVY","XXY","XWY","XYY","YWY","YVX","XYX","VWW","WXX","WXX","YVV","WWV","WVX","WXV","WWY","YVY","YWY","XYX","YXY","XWY","XWY","XWY","XVY","XVX","XWX","YYY","XWY","VWX","WYW","YWV","WYW","WVV","VVV","XXX","WXX","WXX","WYY","XWW","WXV","WXY","YVX","XXX","XWY","XXX","XWY","YYX","YWY","XWY","XWY","XWY","YVX","XWX","YWX","XYX","XWX","VXW","YWV","XWV","WXX","WXX","VYY","WWY","XWV","WXV","WYX","XXX","YWX","XXY","XYY","XYY","XYY","XXY","XXY","XXY","XYY","XYY","XWX","XXX","XYY","XYY","XXY","XWX","XYY","VYW","XVV","WXX","WXX","XXW","WXV","WYY","YXY","YWY","YWX","YWX","YWX","YWY","YXX","YWY","YWY","YYY","YWY","YWY","YXX","YXX","YXX","YWY","YWY","YXX","VVW","VXX","WXX","WXX","